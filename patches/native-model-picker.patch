new file mode 100644
index 0000000..a458831
--- /dev/null
+++ b/linux-features/ui-tweaks/model-picker-native.test.js
@@ -0,0 +1,43 @@
+"use strict";
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const { applyNativeAdvancedViewPatch: apply, REPLACEMENTS, NATIVE_CONTRACTS, descriptors } =
+  require("./patches/model-picker-native.js");
+const legacy = require("./patches/model-picker-model-list.js");
+const context = {feature: {settings: {tweaks: {modelPicker: {
+  showModelsByDefault: {enabled: true, nativeComposer: true},
+}}}}};
+const fixture = [...NATIVE_CONTRACTS,
+  ...REPLACEMENTS.flatMap(([before, , n]) => Array(n).fill(before)),
+  "keep model availability, permissions and effort validation"].join(";");
+
+test("native composer switches both initial states and every reopen reset atomically", () => {
+  const result = apply(fixture, context);
+  for (const [before, after, n] of REPLACEMENTS) {
+    assert.equal(result.includes(before), false);
+    assert.equal(result.split(after).length - 1, n);
+  }
+  for (const contract of NATIVE_CONTRACTS) assert.ok(result.includes(contract));
+  assert.ok(result.endsWith("keep model availability, permissions and effort validation"));
+  assert.equal(apply(result, context), result);
+});
+
+test("native composer refuses missing, duplicate and partially patched contracts", () => {
+  const warn = console.warn;
+  console.warn = () => {};
+  try {
+    for (const changed of [
+      fixture.replace(NATIVE_CONTRACTS[2], "unknown model list"),
+      fixture + NATIVE_CONTRACTS[0],
+      fixture.replace(REPLACEMENTS[0][0], REPLACEMENTS[0][1]),
+      fixture.replace(REPLACEMENTS[2][0], "otherSetter(`simple`)"),
+    ]) assert.equal(apply(changed, context), changed);
+  } finally { console.warn = warn; }
+});
+
+test("native mode replaces the legacy transformations only when explicitly selected", () => {
+  assert.ok(descriptors[0].enabled(context));
+  assert.ok(legacy.descriptors.every((d) => !d.enabled(context)));
+  assert.equal(descriptors[0].enabled({}), false);
+  assert.equal(apply(fixture, {}), fixture);
+});
