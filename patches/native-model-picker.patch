diff --git a/linux-features/ui-tweaks/patches/model-picker-native.js b/linux-features/ui-tweaks/patches/model-picker-native.js
new file mode 100644
index 0000000..6059a56
--- /dev/null
+++ b/linux-features/ui-tweaks/patches/model-picker-native.js
@@ -0,0 +1,64 @@
+"use strict";
+
+// Contract for the signed Linux 26.1021.22027 composer. It already renders a
+// native inline model list and derives efforts from supportedReasoningEfforts.
+// The older submenu/Power mapper transforms must not run on this architecture.
+function nativeComposerEnabled(context) {
+  return context?.feature?.settings?.tweaks?.modelPicker?.showModelsByDefault
+    ?.nativeComposer === true;
+}
+
+const REPLACEMENTS = [
+  ["[_e,ve]=(0,D5.useState)(`simple`)", "[_e,ve]=(0,D5.useState)(`advanced`)", 1],
+  ["[h,g]=(0,e9.useState)(`simple`)", "[h,g]=(0,e9.useState)(`advanced`)", 1],
+  ["ve(`simple`)", "ve(`advanced`)", 2],
+  ["g(`simple`)", "g(`advanced`)", 2],
+];
+const NATIVE_CONTRACTS = [
+  "`chatgpt-model-picker`",
+  "`composer.modelPicker.modelList.heading`",
+  "className:Z8.ModelList,children:[l,ze,Be,He,We,Ge,Ke,d.extras]",
+  "n.supportedReasoningEfforts.filter(e=>Kbe(e.reasoningEffort)&&e.reasoningEffort!==`persistent`)",
+];
+
+function count(source, text) {
+  return source.split(text).length - 1;
+}
+
+function applyNativeAdvancedViewPatch(source, context = {}) {
+  if (!nativeComposerEnabled(context)) return source;
+  const native = typeof source === "string" &&
+    NATIVE_CONTRACTS.every((text) => count(source, text) === 1);
+  const current = native && REPLACEMENTS.every(([before, after, expected]) =>
+    count(source, before) === expected && count(source, after) === 0);
+  const applied = native && REPLACEMENTS.every(([before, after, expected]) =>
+    count(source, before) === 0 && count(source, after) === expected);
+  if (applied) return source;
+  if (!current) {
+    console.warn("WARN: Native composer model list/effort/state contract drifted; no model picker changes applied");
+    return source;
+  }
+  // Change both initial states and close/select resets atomically. Retain all
+  // model availability, access checks, effort validation and click handlers.
+  for (const [before, after] of REPLACEMENTS) source = source.replaceAll(before, after);
+  return source;
+}
+
+module.exports = {
+  nativeComposerEnabled,
+  applyNativeAdvancedViewPatch,
+  REPLACEMENTS,
+  NATIVE_CONTRACTS,
+  descriptors: [{
+    id: "model-picker-native-advanced-view",
+    phase: "webview-asset",
+    order: 20_798,
+    ciPolicy: "optional",
+    enabled: (context) => nativeComposerEnabled(context) &&
+      context?.feature?.settings?.tweaks?.modelPicker?.showModelsByDefault?.enabled !== false,
+    pattern: /^app-primary-[^.]+\.js$/,
+    missingDescription: "native composer model picker bundle",
+    skipDescription: "ui-tweaks native model picker default list",
+    apply: applyNativeAdvancedViewPatch,
+  }],
+};
